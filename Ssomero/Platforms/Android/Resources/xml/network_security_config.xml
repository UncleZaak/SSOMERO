<?xml version="1.0" encoding="utf-8"?>
<!-- Release-safe network security config: disallow cleartext traffic for all domains.
     Local development cleartext exceptions are provided by the debug-only
     network_security_config.debug.xml and are only included in Debug builds.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
</network-security-config>
