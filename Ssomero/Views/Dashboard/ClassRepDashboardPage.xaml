<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:Ssomero.Views.Shared"
             xmlns:conv="clr-namespace:Ssomero.Converters"
             x:Class="Ssomero.Views.Dashboard.ClassRepDashboardPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <shared:AppTopBar Title="Class Representative" />

            <VerticalStackLayout Padding="16,16,16,24" Spacing="20">

                <!-- Stats Cards -->
                <Label Text="Overview" FontSize="16" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <!-- Managed Classes -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 12" Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📚" FontSize="22" />
                            <Label Text="{Binding ManagedClassesCount}" FontSize="24" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                            <Label Text="Managed Classes" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Today's Classes -->
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 12" Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📅" FontSize="22" />
                            <Label Text="{Binding TodayClasses.Count}" FontSize="24" FontAttributes="Bold"
                                   TextColor="#1565C0" />
                            <Label Text="Today's Classes" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Attendance Rate -->
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 12" Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="✅" FontSize="22" />
                            <Label Text="{Binding AttendancePercentage, StringFormat='{0:F0}%'}" FontSize="24" FontAttributes="Bold"
                                   TextColor="#2E7D32" />
                            <Label Text="Attendance Rate" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lecturers -->
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 12" Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="👨‍🏫" FontSize="22" />
                            <Label Text="{Binding TeachingClassesCount}" FontSize="24" FontAttributes="Bold"
                                   TextColor="#6A1B9A" />
                            <Label Text="Lecturers" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <Label Text="Quick Actions" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />

                <VerticalStackLayout Spacing="10">
                    <!-- My Classes -->
                    <Border StrokeShape="RoundRectangle 12" Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToClassesCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="36,*,24">
                            <Label Grid.Column="0" Text="📚" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="My Classes" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                                <Label Text="View your managed classes" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                        </Grid>
                    </Border>

                    <!-- Schedule -->
                    <Border StrokeShape="RoundRectangle 12" Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToScheduleCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="36,*,24">
                            <Label Grid.Column="0" Text="📅" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Schedule" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                                <Label Text="View today's timetable" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                        </Grid>
                    </Border>

                    <!-- Profile -->
                    <Border StrokeShape="RoundRectangle 12" Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="36,*,24">
                            <Label Grid.Column="0" Text="👤" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Profile" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                                <Label Text="Manage your account" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Today's Schedule preview -->
                <Label Text="Today's Schedule" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                       IsVisible="{Binding HasClasses}" />

                <CollectionView ItemsSource="{Binding TodayClasses}"
                                IsVisible="{Binding HasClasses}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10" Padding="14" Margin="0,0,0,8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray900}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" WidthRequest="52">
                                        <Label Text="{Binding Time}" FontSize="13" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                                        <Label Text="{Binding EndTime}" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                                        <Label Text="{Binding CourseName}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Location}" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="No classes today" FontSize="14" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                       IsVisible="{Binding HasClasses, Converter={StaticResource InvertBool}}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
