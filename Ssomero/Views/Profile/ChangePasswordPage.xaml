<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ssomero.Views.Profile.ChangePasswordPage"
             Title="Change Password"
             BackgroundColor="{StaticResource BackgroundColor}"
             AutomationId="ChangePasswordPage">

  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">

      <Label Text="Change Password" Style="{StaticResource TitleLabelStyle}"
             SemanticProperties.HeadingLevel="Level1" />

      <Label Text="Choose a new password for your account."
             FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />

      <!-- Error banner -->
      <Label Text="{Binding ErrorMessage}" TextColor="Red"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
             FontSize="13" />

      <!-- Loading indicator -->
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                         Color="{StaticResource PrimaryColor}" HorizontalOptions="Center" />

      <!-- Toast -->
      <Frame BackgroundColor="{Binding ToastColor}" CornerRadius="8" Padding="12,8"
             IsVisible="{Binding ToastIsVisible}" HasShadow="False">
        <Label Text="{Binding ToastMessage}" TextColor="White" FontSize="13"
               HorizontalTextAlignment="Center" />
      </Frame>

      <!-- Current Password -->
      <VerticalStackLayout Spacing="4">
        <Label Text="Current Password" FontSize="13" TextColor="Gray" />
        <Grid ColumnDefinitions="*,44">
          <Entry Grid.Column="0"
                 Placeholder="Your current password"
                 IsPassword="{Binding IsCurrentPasswordHidden}"
                 Text="{Binding CurrentPassword}"
                 AutomationId="CurrentPasswordEntry" />
          <Button Grid.Column="1"
                  Text="{Binding CurrentPasswordToggleIcon}"
                  Command="{Binding ToggleCurrentPasswordCommand}"
                  BackgroundColor="Transparent" FontSize="18" Padding="0"
                  AutomationId="ToggleCurrentPasswordButton" />
        </Grid>
      </VerticalStackLayout>

      <!-- New Password -->
      <VerticalStackLayout Spacing="4">
        <Label Text="New Password" FontSize="13" TextColor="Gray" />
        <Grid ColumnDefinitions="*,44">
          <Entry Grid.Column="0"
                 Placeholder="Min 8 characters"
                 IsPassword="{Binding IsNewPasswordHidden}"
                 Text="{Binding NewPassword}"
                 AutomationId="NewPasswordEntry" />
          <Button Grid.Column="1"
                  Text="{Binding NewPasswordToggleIcon}"
                  Command="{Binding ToggleNewPasswordCommand}"
                  BackgroundColor="Transparent" FontSize="18" Padding="0"
                  AutomationId="ToggleNewPasswordButton" />
        </Grid>
        <Label Text="{Binding PasswordStrengthHint}"
               TextColor="{Binding PasswordStrengthColor}"
               FontSize="12"
               IsVisible="{Binding PasswordStrengthHint, Converter={StaticResource NullToBoolConverter}}" />
      </VerticalStackLayout>

      <!-- Confirm Password -->
      <VerticalStackLayout Spacing="4">
        <Label Text="Confirm New Password" FontSize="13" TextColor="Gray" />
        <Grid ColumnDefinitions="*,44">
          <Entry Grid.Column="0"
                 Placeholder="Re-enter new password"
                 IsPassword="{Binding IsConfirmPasswordHidden}"
                 Text="{Binding ConfirmPassword}"
                 AutomationId="ConfirmPasswordEntry" />
          <Button Grid.Column="1"
                  Text="{Binding ConfirmPasswordToggleIcon}"
                  Command="{Binding ToggleConfirmPasswordCommand}"
                  BackgroundColor="Transparent" FontSize="18" Padding="0"
                  AutomationId="ToggleConfirmPasswordButton" />
        </Grid>
        <Label Text="✓ Passwords match" TextColor="#22C55E" FontSize="12"
               IsVisible="{Binding DoPasswordsMatch}" />
      </VerticalStackLayout>

      <!-- Submit -->
      <Button Text="Change Password"
              Command="{Binding ChangePasswordCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
              Margin="0,8,0,0"
              AutomationId="SubmitChangePasswordButton" />

      <!-- Back -->
      <Button Text="← Back"
              Command="{Binding GoBackCommand}"
              BackgroundColor="Transparent"
              TextColor="{StaticResource PrimaryColor}"
              FontSize="13"
              AutomationId="ChangePasswordBackButton" />

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
