<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Ssomero.ViewModels"
             xmlns:conv="clr-namespace:Ssomero.Converters"
             x:Class="Ssomero.Views.Lecturer.LecturerAttendancePage"
             BackgroundColor="#F1F5F9"
             Title="Mark Attendance">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvBool"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" BackgroundColor="#5B21B6" Padding="20,20,20,24">
            <VerticalStackLayout Spacing="3">
                <Label Text="Mark Attendance" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Label Text="{Binding SessionLabel}" FontSize="12" TextColor="#C4B5FD"/>
            </VerticalStackLayout>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#5B21B6" HorizontalOptions="Center" VerticalOptions="Center"/>

                <VerticalStackLayout IsVisible="{Binding HasError}"
                                     HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="Could not load students." FontSize="14" TextColor="#64748B"
                           HorizontalOptions="Center"/>
                    <Button Text="Retry" Command="{Binding LoadCommand}"
                            BackgroundColor="#5B21B6" TextColor="White"
                            CornerRadius="10" Padding="24,10" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Label Text="No students enrolled."
                       IsVisible="{Binding IsEmpty}"
                       FontSize="14" TextColor="#64748B"
                       HorizontalOptions="Center" VerticalOptions="Center"/>

                <CollectionView ItemsSource="{Binding Students}"
                                IsVisible="{Binding IsEmpty, Converter={StaticResource InvBool}}"
                                SelectionMode="None"
                                Margin="0,8,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,0" Padding="16,12" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.07"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding StudentName}"
                                           FontSize="14" FontAttributes="Bold" TextColor="#0F172A"
                                           VerticalOptions="Center"/>
                                    <Switch Grid.Column="1" IsToggled="{Binding IsPresent}"
                                            OnColor="#22C55E" ThumbColor="White"
                                            VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </RefreshView>

        <Border Grid.Row="2" Padding="16,12" BackgroundColor="White" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#1A000000" Offset="0,-2" Radius="8" Opacity="0.08"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="8">
                <Border IsVisible="{Binding ToastIsVisible}"
                        BackgroundColor="{Binding ToastColor}"
                        StrokeShape="RoundRectangle 8" StrokeThickness="0"
                        Padding="14,8">
                    <Label Text="{Binding ToastMessage}" TextColor="White" FontSize="13"
                           HorizontalOptions="Center"/>
                </Border>
                <Button Text="Save Attendance"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InvBool}}"
                        BackgroundColor="#5B21B6" TextColor="White"
                        FontSize="15" FontAttributes="Bold"
                        CornerRadius="12" HeightRequest="52"/>
                <ActivityIndicator IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}"
                                   Color="#5B21B6" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
