<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Ssomero.ViewModels"
             xmlns:models="clr-namespace:Ssomero.Models"
             xmlns:conv="clr-namespace:Ssomero.Converters"
             x:Class="Ssomero.Views.Lecturer.LecturerMaterialsPage"
             BackgroundColor="#F1F5F9"
             Title="Materials">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvBool"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" BackgroundColor="#5B21B6" Padding="20,20,20,24">
            <VerticalStackLayout Spacing="3">
                <Label Text="Materials" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Label Text="{Binding ClassName}" FontSize="12" TextColor="#C4B5FD"/>
            </VerticalStackLayout>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#5B21B6" HorizontalOptions="Center" VerticalOptions="Center"/>

                <VerticalStackLayout IsVisible="{Binding HasError}"
                                     HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="Could not load materials." FontSize="14" TextColor="#64748B"
                           HorizontalOptions="Center"/>
                    <Button Text="Retry" Command="{Binding LoadCommand}"
                            BackgroundColor="#5B21B6" TextColor="White"
                            CornerRadius="10" Padding="24,10" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Label Text="No materials uploaded yet."
                       IsVisible="{Binding IsEmpty}"
                       FontSize="14" TextColor="#64748B"
                       HorizontalOptions="Center" VerticalOptions="Center"/>

                <CollectionView ItemsSource="{Binding Materials}"
                                IsVisible="{Binding IsEmpty, Converter={StaticResource InvBool}}"
                                SelectionMode="None"
                                Margin="0,8,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,0" Padding="16" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.07"/>
                                </Border.Shadow>
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="14" FontAttributes="Bold" TextColor="#0F172A"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Row="1"
                                           Text="{Binding FileUrl}"
                                           FontSize="11" TextColor="#94A3B8"
                                           IsVisible="{Binding HasUrl}"
                                           LineBreakMode="TailTruncation"
                                           Margin="0,2,0,0"/>
                                    <Label Grid.Row="2"
                                           Text="{Binding CreatedAtLabel}"
                                           FontSize="11" TextColor="#CBD5E1"
                                           Margin="0,6,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </RefreshView>

        <Border Grid.Row="2" Padding="16,14" BackgroundColor="White" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#1A000000" Offset="0,-2" Radius="8" Opacity="0.08"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="10">
                <Border IsVisible="{Binding ToastIsVisible}"
                        BackgroundColor="{Binding ToastColor}"
                        StrokeShape="RoundRectangle 8" StrokeThickness="0"
                        Padding="14,8">
                    <Label Text="{Binding ToastMessage}" TextColor="White" FontSize="13"
                           HorizontalOptions="Center"/>
                </Border>
                <Label Text="Upload New Material" FontSize="14" FontAttributes="Bold" TextColor="#374151"/>
                <Entry Placeholder="Title (required)"
                       Text="{Binding NewTitle}"
                       BackgroundColor="#F8FAFC" FontSize="13" HeightRequest="44"/>
                <Entry Placeholder="File URL (optional)"
                       Text="{Binding NewFileUrl}"
                       Keyboard="Url"
                       BackgroundColor="#F8FAFC" FontSize="13" HeightRequest="44"/>
                <Button Text="Upload"
                        Command="{Binding UploadCommand}"
                        IsEnabled="{Binding IsUploading, Converter={StaticResource InvBool}}"
                        BackgroundColor="#5B21B6" TextColor="White"
                        FontSize="14" FontAttributes="Bold"
                        CornerRadius="10" HeightRequest="48"/>
                <ActivityIndicator IsRunning="{Binding IsUploading}" IsVisible="{Binding IsUploading}"
                                   Color="#5B21B6" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
