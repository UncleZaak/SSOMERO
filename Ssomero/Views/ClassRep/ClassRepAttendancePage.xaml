<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Ssomero.Converters"
             x:Class="Ssomero.Views.ClassRep.ClassRepAttendancePage"
             Shell.NavBarIsVisible="True"
             Title="Attendance Reports"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvBool"/>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,24" Spacing="16">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" Margin="0,24,0,0"/>

                <!-- Error banner -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="#FEE2E2" StrokeShape="RoundRectangle 10"
                        Stroke="#FCA5A5" Padding="12,10">
                    <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="13"/>
                </Border>

                <!-- No data state -->
                <VerticalStackLayout IsVisible="{Binding HasError}"
                                     HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="10" Margin="0,24,0,0">
                </VerticalStackLayout>

                <!-- Summary cards -->
                <VerticalStackLayout IsVisible="{Binding HasError, Converter={StaticResource InvBool}}"
                                     Spacing="16">

                    <!-- Average attendance rate card -->
                    <Border StrokeShape="RoundRectangle 14" Padding="20"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                        <Border.Shadow>
                            <Shadow Brush="#1A000000" Offset="0,3" Radius="8" Opacity="0.08"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Average Attendance Rate" FontSize="14"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                                    <Label Text="{Binding Summary.AttendanceRateLabel}" FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="📊" FontSize="36" VerticalOptions="Center"/>
                            </Grid>
                            <ProgressBar Progress="{Binding Summary.AttendanceRateProgress}"
                                         ProgressColor="{Binding Summary.RateColor}"
                                         HeightRequest="10"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Total sessions card -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 14" Padding="16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <Border.Shadow>
                                <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.07"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="📅" FontSize="24"/>
                                <Label Text="{Binding Summary.TotalSessions}" FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                                <Label Text="Total Sessions" FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" StrokeShape="RoundRectangle 14" Padding="16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <Border.Shadow>
                                <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.07"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="✅" FontSize="24"/>
                                <Label Text="{Binding Summary.TotalAttendances}" FontSize="28"
                                       FontAttributes="Bold" TextColor="#22C55E"/>
                                <Label Text="Total Attendances" FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
