<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ssomero.Views.Search.SearchPage"
             Title="Search"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource LoginBgDark}}">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
        <Label Text="🔍" FontSize="48" HorizontalOptions="Center" />
        <Label Text="Search" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark=White}" />
        <Label Text="Coming soon" TextColor="{StaticResource MutedText}" FontSize="14" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
