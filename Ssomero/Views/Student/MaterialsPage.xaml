<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ssomero.Views.Student.MaterialsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ssomero.ViewModels"
    xmlns:model="clr-namespace:Ssomero.Models"
    xmlns:conv="clr-namespace:Ssomero.Converters"
    BackgroundColor="#F1F5F9"
    Title="Materials">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvBool" />
        <conv:NullToBoolConverter x:Key="NotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <VerticalStackLayout Padding="20,16,20,16"
                           BackgroundColor="#5B21B6" Grid.Row="0">
            <Label Text="Course Materials" FontSize="22" FontAttributes="Bold" TextColor="White"/>
            <Label Text="PDFs, videos and links from your lecturers"
                   FontSize="13" TextColor="#C4B5FD" Margin="0,2,0,0"/>
        </VerticalStackLayout>

        <!-- Search + Filter bar -->
        <VerticalStackLayout Grid.Row="1" BackgroundColor="White"
                             Padding="16,10" Spacing="8">
            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                    BackgroundColor="#F1F5F9" Padding="8,4">
                <SearchBar Placeholder="Search materials..."
                           Text="{Binding SearchQuery}"
                           BackgroundColor="Transparent"
                           TextColor="#0F172A"/>
            </Border>
            <CollectionView ItemsSource="{Binding CourseFilters}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedFilter}"
                            HeightRequest="36">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="12,6" StrokeShape="RoundRectangle 16"
                                StrokeThickness="0" BackgroundColor="#EDE9FE">
                            <Label Text="{Binding .}" FontSize="12"
                                   TextColor="#5B21B6" FontAttributes="Bold"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- List -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Items}"
                                IsVisible="{Binding IsEmpty, Converter={StaticResource InvBool}}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:StudyMaterialDto">
                            <Border Margin="16,0" Padding="14" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.07"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="48,*,Auto">

                                    <!-- File type icon -->
                                    <Border Grid.Column="0" BackgroundColor="#EDE9FE"
                                            StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                            WidthRequest="44" HeightRequest="44">
                                        <Label Text="📄" FontSize="22"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                        <Label Text="{Binding Topic}" FontSize="14"
                                               FontAttributes="Bold" TextColor="#0F172A"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding CourseName}" FontSize="12"
                                               TextColor="#5B21B6"/>
                                        <Label Text="{Binding UploadedAt, StringFormat='Added {0:MMM dd, yyyy}'}"
                                               FontSize="11" TextColor="#94A3B8"/>
                                    </VerticalStackLayout>

                                    <!-- Open button -->
                                    <ImageButton Grid.Column="2"
                                                 Source="open_icon.png"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MaterialsViewModel}}, Path=OpenMaterialCommand}"
                                                 CommandParameter="{Binding .}"
                                                 WidthRequest="36" HeightRequest="36"
                                                 BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Header>
                        <BoxView HeightRequest="8" Color="Transparent"/>
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="20" Color="Transparent"/>
                    </CollectionView.Footer>
                </CollectionView>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="📂" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="No materials found" FontSize="16" TextColor="#64748B"
                           HorizontalOptions="Center"/>
                    <Label Text="Materials uploaded by your lecturers will appear here"
                           FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" Margin="32,0"/>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#5B21B6" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>
