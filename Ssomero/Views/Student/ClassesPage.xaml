<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ssomero.Views.Student.ClassesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ssomero.ViewModels"
    xmlns:conv="clr-namespace:Ssomero.Converters"
    xmlns:model="clr-namespace:Ssomero.Models"
    Shell.TabBarIsVisible="True"
    BackgroundColor="#F1F5F9"
    Title="My Classes">

    <ContentPage.Resources>
        <conv:AttendanceColorConverter x:Key="AttColor" />
        <conv:InvertBoolConverter      x:Key="InvBool"  />
        <conv:PercentToDoubleConverter x:Key="PctConv"  />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout Padding="20,16,20,12" BackgroundColor="#5B21B6" Grid.Row="0">
            <Label Text="My Classes" FontSize="22" FontAttributes="Bold" TextColor="White" />
            <Label Text="Enrolled course units" FontSize="13" TextColor="#C4B5FD" Margin="0,2,0,0"/>
        </VerticalStackLayout>

        <!-- Content -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <Grid RowDefinitions="*">

                <!-- List -->
                <CollectionView ItemsSource="{Binding Items}"
                                IsVisible="{Binding IsEmpty, Converter={StaticResource InvBool}}"
                                Margin="0,8,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClassItemVm">
                            <Border Margin="16,0" Padding="16" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.08"/>
                                </Border.Shadow>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                    <!-- Course name -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="#0F172A" LineBreakMode="TailTruncation"/>

                                    <!-- Attendance badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="8,3"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding AttendancePct, Converter={StaticResource AttColor}}">
                                        <Label Text="{Binding AttendancePctText}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="White"/>
                                    </Border>

                                    <!-- Lecturer -->
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding LecturerName, StringFormat='👤 {0}'}"
                                           FontSize="13" TextColor="#64748B"
                                           Margin="0,4,0,0"/>

                                    <!-- Progress bar -->
                                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2"
                                                 Progress="{Binding AttendancePct, Converter={StaticResource PctConv}}"
                                                 ProgressColor="{Binding AttendancePct, Converter={StaticResource AttColor}}"
                                                 BackgroundColor="#E2E8F0"
                                                 HeightRequest="6"
                                                 Margin="0,10,0,0"/>

                                    <!-- Actions -->
                                    <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2"
                                                           Spacing="8" Margin="0,10,0,0">
                                        <Button Text="Open Class"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClassesViewModel}}, Path=OpenClassCommand}"
                                                CommandParameter="{Binding Id}"
                                                BackgroundColor="#5B21B6" TextColor="White"
                                                FontSize="12" CornerRadius="8"
                                                HeightRequest="34" Padding="12,0"/>
                                        <Button Text="Mark Attendance"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClassesViewModel}}, Path=MarkAttendanceCommand}"
                                                CommandParameter="{Binding Id}"
                                                BackgroundColor="#EDE9FE" TextColor="#5B21B6"
                                                FontSize="12" CornerRadius="8"
                                                HeightRequest="34" Padding="12,0"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="20" Color="Transparent"/>
                    </CollectionView.Footer>
                </CollectionView>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="10">
                    <Label Text="📚" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="No enrolled classes yet" FontSize="16" TextColor="#64748B"
                           HorizontalOptions="Center"/>
                    <Label Text="Your enrolled course units will appear here"
                           FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Error -->
                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource InvBool}, ConverterParameter=invert}"
                        BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 8"
                        StrokeThickness="0" Margin="16,8" Padding="12,8"
                        VerticalOptions="End">
                    <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="13"/>
                </Border>

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#5B21B6"
                                   VerticalOptions="Center" HorizontalOptions="Center"/>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>

