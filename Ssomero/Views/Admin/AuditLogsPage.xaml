<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Ssomero.ViewModels"
             xmlns:models="clr-namespace:Ssomero.Models"
             x:Class="Ssomero.Views.Admin.AuditLogsPage"
             x:DataType="vm:AuditLogsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <x:Array x:Key="ActionOptions" Type="{x:Type x:String}">
                <x:String>All</x:String>
                <x:String>CREATE</x:String>
                <x:String>UPDATE</x:String>
                <x:String>DELETE</x:String>
                <x:String>APPROVE</x:String>
                <x:String>SUSPEND</x:String>
                <x:String>ACTIVATE</x:String>
            </x:Array>
            <x:Array x:Key="EntityOptions" Type="{x:Type x:String}">
                <x:String>All</x:String>
                <x:String>Student</x:String>
                <x:String>Lecturer</x:String>
                <x:String>Department</x:String>
                <x:String>Program</x:String>
                <x:String>Curriculum</x:String>
                <x:String>University</x:String>
                <x:String>Faculty</x:String>
            </x:Array>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <ScrollView>
            <VerticalStackLayout Padding="16,52,16,32" Spacing="14">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Audit Logs" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource TextColor}"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding PageInfo}" FontSize="12"
                               TextColor="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="↻" Command="{Binding RefreshCommand}"
                            BackgroundColor="Transparent" TextColor="{StaticResource PrimaryColor}"
                            FontSize="20" Padding="8,4" WidthRequest="44" HeightRequest="44"
                            SemanticProperties.Description="Refresh audit logs" />
                </Grid>

                <!-- Search bar -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray200}"
                        BackgroundColor="{StaticResource CardBackground}" Padding="0">
                    <SearchBar Placeholder="Search by action, entity, user..."
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}"
                               FontSize="14" BackgroundColor="Transparent"
                               SemanticProperties.Description="Search audit logs" />
                </Border>

                <!-- Filters row -->
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                    <Picker Grid.Column="0" Title="Action" SelectedItem="{Binding SelectedAction}"
                            ItemsSource="{StaticResource ActionOptions}"
                            FontSize="13"
                            SemanticProperties.Description="Filter by action type" />
                    <Picker Grid.Column="1" Title="Entity" SelectedItem="{Binding SelectedEntity}"
                            ItemsSource="{StaticResource EntityOptions}"
                            FontSize="13"
                            SemanticProperties.Description="Filter by entity type" />
                    <Button Grid.Column="2" Text="Apply" Command="{Binding SearchCommand}"
                            BackgroundColor="{StaticResource PrimaryColor}" TextColor="White"
                            CornerRadius="10" Padding="14,0" HeightRequest="42" FontSize="13" />
                </Grid>

                <!-- Clear filters button -->
                <Button Text="✕  Clear Filters" Command="{Binding ClearCommand}"
                        IsVisible="{Binding HasFilters}"
                        BackgroundColor="Transparent" TextColor="{StaticResource MutedText}"
                        FontSize="13" HorizontalOptions="Start" Padding="0"
                        SemanticProperties.Description="Clear all active filters" />

                <!-- Error banner -->
                <Border IsVisible="{Binding HasError}" StrokeShape="RoundRectangle 10"
                        Stroke="#FCA5A5" BackgroundColor="#FEF2F2" Padding="14">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="⚠️" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Could not load audit logs." TextColor="#DC2626" FontSize="14"
                                   FontAttributes="Bold" />
                            <Button Text="Retry" Command="{Binding LoadCommand}"
                                    BackgroundColor="#EF4444" TextColor="White"
                                    CornerRadius="8" Padding="16,6" FontSize="13"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="16"
                                     HorizontalOptions="Center" Margin="0,40,0,0">
                    <Label Text="📋" FontSize="56" HorizontalOptions="Center"
                           SemanticProperties.Description="No logs found" />
                    <Label Text="No audit logs found" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextColor}" HorizontalOptions="Center" />
                    <Label Text="Try adjusting your filters or check back later."
                           FontSize="14" TextColor="{StaticResource MutedText}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Button Text="Clear Filters" Command="{Binding ClearCommand}"
                            BackgroundColor="{StaticResource PrimaryColor}" TextColor="White"
                            CornerRadius="10" Padding="24,10" HorizontalOptions="Center"
                            SemanticProperties.Description="Clear filters to see all logs" />
                </VerticalStackLayout>

                <!-- Loading indicator (first load) -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryColor}"
                                   HorizontalOptions="Center" HeightRequest="40" />

                <!-- Log timeline list -->
                <CollectionView ItemsSource="{Binding Logs}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AuditLogDto">
                            <Grid Padding="0,0,0,10">
                                <!-- Timeline connector line -->
                                <BoxView Grid.Row="0" BackgroundColor="{StaticResource Gray200}"
                                         WidthRequest="2" HorizontalOptions="Start"
                                         Margin="19,20,0,0" VerticalOptions="Fill" />

                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource Gray200}"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        Padding="14" Margin="36,0,0,0">
                                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12">

                                        <!-- Action icon badge -->
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 18"
                                                Stroke="Transparent"
                                                BackgroundColor="{Binding ActionColor}"
                                                WidthRequest="36" HeightRequest="36"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Start"
                                                SemanticProperties.Description="{Binding Action}">
                                            <Label Text="{Binding ActionIcon}" FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Action}" FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding ActionColor}" />
                                                <Label Grid.Column="1" Text="{Binding FormattedDate}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource MutedText}" />
                                            </Grid>
                                            <Label FontSize="13" TextColor="{StaticResource TextColor}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding EntityName}"
                                                              FontAttributes="Bold" />
                                                        <Span Text=" · " />
                                                        <Span Text="{Binding EntityId}"
                                                              TextColor="{StaticResource MutedText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding PerformedBy}" FontSize="12"
                                                   TextColor="{StaticResource MutedText}"
                                                   SemanticProperties.Description="Performed by" />
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>

                                <!-- Timeline dot -->
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        Stroke="{StaticResource PrimaryColor}"
                                        StrokeThickness="2"
                                        WidthRequest="16" HeightRequest="16"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="12,12,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Pagination bar -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                      IsVisible="{Binding IsEmpty, Converter={StaticResource InvertBoolConverter}}"
                      Margin="0,8,0,0">
                    <Button Grid.Column="0" Text="← Prev" Command="{Binding PrevPageCommand}"
                            BackgroundColor="{StaticResource Gray100}"
                            TextColor="{StaticResource TextColor}"
                            CornerRadius="10" Padding="14,0" HeightRequest="40" FontSize="13"
                            SemanticProperties.Description="Previous page" />
                    <Label Grid.Column="1" Text="{Binding PageInfo}" FontSize="12"
                           TextColor="{StaticResource MutedText}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="Next →" Command="{Binding NextPageCommand}"
                            BackgroundColor="{StaticResource PrimaryColor}" TextColor="White"
                            CornerRadius="10" Padding="14,0" HeightRequest="40" FontSize="13"
                            SemanticProperties.Description="Next page" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay (pagination) -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#30000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HeightRequest="40" WidthRequest="40" />
        </Grid>

        <!-- Toast overlay -->
        <Border IsVisible="{Binding ToastIsVisible}"
                BackgroundColor="{Binding ToastColor}"
                StrokeShape="RoundRectangle 14" Stroke="Transparent"
                Padding="20,12" HorizontalOptions="Center" VerticalOptions="End"
                Margin="16,0,16,52" ZIndex="9999">
            <Label Text="{Binding ToastMessage}" TextColor="White"
                   FontSize="14" HorizontalTextAlignment="Center" />
        </Border>

    </Grid>
</ContentPage>
