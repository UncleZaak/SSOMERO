<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Ssomero.Converters"
             xmlns:vm="clr-namespace:Ssomero.ViewModels"
             xmlns:models="clr-namespace:Ssomero.Models"
             x:Class="Ssomero.Views.Admin.UsersPage"
             x:DataType="vm:UsersViewModel"
             Title="User Management"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Main content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- Header row with bulk toggle -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="User Management" FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource TextColor}"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="Manage students and lecturers" FontSize="14"
                               TextColor="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Select" Command="{Binding ToggleBulkModeCommand}"
                            BackgroundColor="{StaticResource Gray100}"
                            TextColor="{StaticResource TextColor}"
                            CornerRadius="10" Padding="14,0" HeightRequest="38" FontSize="13"
                            SemanticProperties.Description="Toggle bulk selection mode">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBulkMode}" Value="True">
                                <Setter Property="Text" Value="Cancel" />
                                <Setter Property="BackgroundColor" Value="#EF4444" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Search -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray200}"
                        BackgroundColor="{StaticResource CardBackground}" Padding="0">
                    <SearchBar Placeholder="Search by name or email..."
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}"
                               FontSize="14" BackgroundColor="Transparent"
                               SemanticProperties.Description="Search users" />
                </Border>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12"
                            Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}"
                            Padding="14" Shadow="{OnPlatform Default={Shadow Brush=#10000000, Offset='0,2', Radius=8}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👨‍🎓" FontSize="20" SemanticProperties.Description="Students" />
                            <Label Text="{Binding TotalStudents}" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource TextColor}" />
                            <Label Text="Students" FontSize="11" TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12"
                            Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}"
                            Padding="14" Shadow="{OnPlatform Default={Shadow Brush=#10000000, Offset='0,2', Radius=8}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👨‍🏫" FontSize="20" SemanticProperties.Description="Lecturers" />
                            <Label Text="{Binding TotalLecturers}" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource TextColor}" />
                            <Label Text="Lecturers" FontSize="11" TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 12"
                            Stroke="Transparent" BackgroundColor="{StaticResource CardBackground}"
                            Padding="14" Shadow="{OnPlatform Default={Shadow Brush=#10000000, Offset='0,2', Radius=8}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⚠️" FontSize="20" SemanticProperties.Description="Suspended" />
                            <Label Text="{Binding TotalSuspended}" FontSize="22" FontAttributes="Bold"
                                   TextColor="#F59E0B" />
                            <Label Text="Suspended" FontSize="11" TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" StrokeShape="RoundRectangle 12"
                            Stroke="#FECACA" BackgroundColor="{StaticResource CardBackground}"
                            Padding="14" Shadow="{OnPlatform Default={Shadow Brush=#10000000, Offset='0,2', Radius=8}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⏳" FontSize="20" SemanticProperties.Description="Pending approval" />
                            <Label Text="{Binding PendingLecturers}" FontSize="22" FontAttributes="Bold"
                                   TextColor="#EF4444" />
                            <Label Text="Pending" FontSize="11" TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Tab Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Students"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Students"
                            FontSize="14" HeightRequest="42" CornerRadius="10">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsStudentsTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsStudentsTab}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
                                <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Lecturers"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Lecturers"
                            FontSize="14" HeightRequest="42" CornerRadius="10">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsLecturersTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsLecturersTab}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
                                <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Error banner -->
                <Border IsVisible="{Binding HasError}" StrokeShape="RoundRectangle 8"
                        Stroke="#FCA5A5" BackgroundColor="#FEF2F2" Padding="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Retry" Command="{Binding LoadCommand}"
                                BackgroundColor="#EF4444" TextColor="White"
                                CornerRadius="8" Padding="12,4" FontSize="12"
                                SemanticProperties.Description="Retry loading users" />
                    </Grid>
                </Border>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="16"
                                     HorizontalOptions="Center" Margin="0,40,0,0">
                    <Label Text="👥" FontSize="56" HorizontalOptions="Center"
                           SemanticProperties.Description="No users" />
                    <Label Text="No users found" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextColor}" HorizontalOptions="Center" />
                    <Label Text="Try a different search or switch tabs."
                           FontSize="14" TextColor="{StaticResource MutedText}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Select-all row (bulk mode only) -->
                <Border IsVisible="{Binding IsBulkMode}" StrokeShape="RoundRectangle 10"
                        Stroke="{StaticResource Gray200}"
                        BackgroundColor="{StaticResource CardBackground}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <CheckBox Grid.Column="0" Color="{StaticResource PrimaryColor}"
                                  SemanticProperties.Description="Select all users" />
                        <Label Grid.Column="1" FontSize="13" VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SelectedCount}" FontAttributes="Bold" />
                                    <Span Text=" selected" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Grid.Column="2" Text="Select All" Command="{Binding ToggleSelectAllCommand}"
                                BackgroundColor="Transparent" TextColor="{StaticResource PrimaryColor}"
                                FontSize="13" Padding="0"
                                SemanticProperties.Description="Toggle select all" />
                    </Grid>
                </Border>

                <!-- User List -->
                <CollectionView ItemsSource="{Binding FilteredUsers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserItem">
                            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray200}"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="14" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,48,*,Auto" ColumnSpacing="12"
                                      RowDefinitions="Auto,Auto">

                                    <!-- Checkbox (bulk mode) -->
                                    <CheckBox Grid.Column="0" Grid.RowSpan="2"
                                              IsChecked="{Binding IsSelected}"
                                              Color="{StaticResource PrimaryColor}"
                                              IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=IsBulkMode}"
                                              VerticalOptions="Center"
                                              SemanticProperties.Description="{Binding Name}" />

                                    <!-- Avatar -->
                                    <Border Grid.Column="1" Grid.RowSpan="2"
                                            StrokeShape="RoundRectangle 24"
                                            Stroke="Transparent" BackgroundColor="{StaticResource Secondary}"
                                            WidthRequest="48" HeightRequest="48"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Initials}" FontSize="16" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Name + Subtitle -->
                                    <VerticalStackLayout Grid.Column="2" Grid.Row="0" Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource TextColor}"
                                               LineBreakMode="TailTruncation"
                                               SemanticProperties.Description="{Binding Name}" />
                                        <Label Text="{Binding Email}" FontSize="12"
                                               TextColor="{StaticResource MutedText}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding DisplaySubtitle}" FontSize="11"
                                               TextColor="{StaticResource MutedText}" />
                                    </VerticalStackLayout>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="3" Grid.Row="0"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="Transparent" Padding="8,4"
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColor}}"
                                            VerticalOptions="Start" HorizontalOptions="End">
                                        <Label Text="{Binding Status}" FontSize="11" TextColor="White"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <!-- Action Buttons (hidden in bulk mode) -->
                                    <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="3"
                                                           Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                                        <HorizontalStackLayout.Triggers>
                                            <DataTrigger TargetType="HorizontalStackLayout"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=IsBulkMode}"
                                                         Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </HorizontalStackLayout.Triggers>

                                        <Button Text="Approve" FontSize="12"
                                                BackgroundColor="#10B981" TextColor="White"
                                                CornerRadius="8" Padding="10,6" HeightRequest="32"
                                                IsVisible="{Binding IsPendingApproval}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=ApproveCommand}"
                                                CommandParameter="{Binding .}"
                                                SemanticProperties.Description="Approve lecturer" />
                                        <Button Text="Suspend" FontSize="12"
                                                BackgroundColor="#F59E0B" TextColor="White"
                                                CornerRadius="8" Padding="10,6" HeightRequest="32"
                                                IsVisible="{Binding IsActive}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=SuspendCommand}"
                                                CommandParameter="{Binding .}"
                                                SemanticProperties.Description="Suspend user" />
                                        <Button Text="Activate" FontSize="12"
                                                BackgroundColor="#22C55E" TextColor="White"
                                                CornerRadius="8" Padding="10,6" HeightRequest="32"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=ActivateCommand}"
                                                CommandParameter="{Binding .}"
                                                SemanticProperties.Description="Activate user">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="Delete" FontSize="12"
                                                BackgroundColor="#EF4444" TextColor="White"
                                                CornerRadius="8" Padding="10,6" HeightRequest="32"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=DeleteCommand}"
                                                CommandParameter="{Binding .}"
                                                SemanticProperties.Description="Delete user" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bulk action bar (docked at bottom) -->
        <Border Grid.Row="1" IsVisible="{Binding IsBulkMode}"
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0"
                Shadow="{OnPlatform Default={Shadow Brush=#20000000, Offset='0,-2', Radius=10}}">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="16,10">
                <Button Grid.Column="0" Text="Suspend" Command="{Binding BulkSuspendCommand}"
                        IsEnabled="{Binding HasSelection}"
                        BackgroundColor="#F59E0B" TextColor="White" CornerRadius="10"
                        HeightRequest="44" FontSize="13"
                        SemanticProperties.Description="Bulk suspend selected users" />
                <Button Grid.Column="1" Text="Activate" Command="{Binding BulkActivateCommand}"
                        IsEnabled="{Binding HasSelection}"
                        BackgroundColor="#22C55E" TextColor="White" CornerRadius="10"
                        HeightRequest="44" FontSize="13"
                        SemanticProperties.Description="Bulk activate selected users" />
                <Button Grid.Column="2" Text="Delete" Command="{Binding BulkDeleteCommand}"
                        IsEnabled="{Binding HasSelection}"
                        BackgroundColor="#EF4444" TextColor="White" CornerRadius="10"
                        HeightRequest="44" FontSize="13"
                        SemanticProperties.Description="Bulk delete selected users" />
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" BackgroundColor="#60000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HeightRequest="48" WidthRequest="48" />
        </Grid>

        <!-- Toast overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ToastIsVisible}"
                BackgroundColor="{Binding ToastColor}"
                StrokeShape="RoundRectangle 14" Stroke="Transparent"
                Padding="20,12" HorizontalOptions="Center" VerticalOptions="End"
                Margin="16,0,16,64" ZIndex="9999">
            <Label Text="{Binding ToastMessage}" TextColor="White"
                   FontSize="14" HorizontalTextAlignment="Center" />
        </Border>

    </Grid>
</ContentPage>
