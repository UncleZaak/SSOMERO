<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Ssomero.Views.StartupPage"
    BackgroundColor="#FFF8F0"
    Shell.NavBarIsVisible="False"
    Padding="24"
    >

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">

    <!-- top spacer (status/safe area) -->
    <BoxView Grid.Row="0" HeightRequest="12" Color="Transparent" />

    <!-- main centered content -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <VerticalStackLayout
          HorizontalOptions="Center"
          VerticalOptions="Center"
          Spacing="12"
          WidthRequest="600">

        <!-- Logo -->
        <Image x:Name="LogoImage"
               Source="ssomero.png"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               Opacity="0"
               HeightRequest="{OnIdiom Phone=160, Tablet=240, Desktop=240}" />

        <!-- App Title -->
        <Label x:Name="TitleLabel"
               Text="SSOMERO"
               Opacity="0"
               HorizontalTextAlignment="Center"
               TextColor="#1b1b1b"
               FontFamily="OpenSans-Semibold"
               FontSize="{OnIdiom Phone=28, Tablet=40, Desktop=44}" />

        <!-- Subtitle -->
        <Label x:Name="SubtitleLabel"
               Text="School Management System"
               Opacity="0"
               HorizontalTextAlignment="Center"
               TextColor="#6b6b6b"
               FontFamily="OpenSans-Regular"
               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}" />

      </VerticalStackLayout>
    </Grid>

    <!-- bottom center credit -->
    <Grid Grid.Row="2">
      <Label Text="ILK"
             HorizontalOptions="Center"
             VerticalOptions="End"
             Margin="0,6"
             TextColor="#9a9a9a"
             FontFamily="OpenSans-Regular"
             FontSize="12" />
    </Grid>

  </Grid>

</ContentPage>
