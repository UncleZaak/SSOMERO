<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ssomero.Views.Auth.ResetPasswordPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             AutomationId="ResetPasswordPage">

  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">

      <Label Text="Reset Password" Style="{StaticResource TitleLabelStyle}"
             SemanticProperties.HeadingLevel="Level1" />

      <Label Text="Choose a new password for your account."
             FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />

      <!-- Error banner -->
      <Label Text="{Binding ErrorMessage}" TextColor="Red"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
             FontSize="13" />

      <!-- Loading indicator -->
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                         Color="{StaticResource PrimaryColor}" HorizontalOptions="Center" />

      <!-- Toast -->
      <Frame BackgroundColor="{Binding ToastColor}" CornerRadius="8" Padding="12,8"
             IsVisible="{Binding ToastIsVisible}" HasShadow="False">
        <Label Text="{Binding ToastMessage}" TextColor="White" FontSize="13"
               HorizontalTextAlignment="Center" />
      </Frame>

      <!-- New Password -->
      <VerticalStackLayout Spacing="4">
        <Label Text="New Password" FontSize="13" TextColor="Gray" />
        <Grid ColumnDefinitions="*,44">
          <Entry Grid.Column="0"
                 Placeholder="New password (min 8 characters)"
                 IsPassword="{Binding IsPasswordHidden}"
                 Text="{Binding NewPassword}"
                 AutomationId="NewPasswordEntry" />
          <Button Grid.Column="1"
                  Text="{Binding PasswordToggleIcon}"
                  Command="{Binding TogglePasswordCommand}"
                  BackgroundColor="Transparent"
                  FontSize="18" Padding="0"
                  AutomationId="ToggleNewPasswordButton" />
        </Grid>
        <Label Text="{Binding PasswordStrengthHint}"
               TextColor="{Binding PasswordStrengthColor}"
               FontSize="12"
               IsVisible="{Binding PasswordStrengthHint, Converter={StaticResource NullToBoolConverter}}" />
      </VerticalStackLayout>

      <!-- Confirm Password -->
      <VerticalStackLayout Spacing="4">
        <Label Text="Confirm Password" FontSize="13" TextColor="Gray" />
        <Grid ColumnDefinitions="*,44">
          <Entry Grid.Column="0"
                 Placeholder="Re-enter new password"
                 IsPassword="{Binding IsConfirmPasswordHidden}"
                 Text="{Binding ConfirmPassword}"
                 AutomationId="ConfirmPasswordEntry" />
          <Button Grid.Column="1"
                  Text="{Binding ConfirmPasswordToggleIcon}"
                  Command="{Binding ToggleConfirmPasswordCommand}"
                  BackgroundColor="Transparent"
                  FontSize="18" Padding="0"
                  AutomationId="ToggleConfirmPasswordButton" />
        </Grid>
        <Label Text="✓ Passwords match" TextColor="#22C55E" FontSize="12"
               IsVisible="{Binding DoPasswordsMatch}" />
      </VerticalStackLayout>

      <!-- Submit -->
      <Button Text="Reset Password"
              Command="{Binding ResetPasswordCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
              AutomationId="ResetPasswordButton" />

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
