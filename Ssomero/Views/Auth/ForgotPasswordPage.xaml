<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ssomero.Views.Auth.ForgotPasswordPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             AutomationId="ForgotPasswordPage">

  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">

      <Label Text="Forgot Password" Style="{StaticResource TitleLabelStyle}"
             SemanticProperties.HeadingLevel="Level1" />

      <Label Text="Enter your registered email to receive a reset code."
             FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />

      <!-- Error banner -->
      <Label Text="{Binding ErrorMessage}" TextColor="Red"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
             FontSize="13" />

      <!-- Loading indicator -->
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                         Color="{StaticResource PrimaryColor}" HorizontalOptions="Center" />

      <!-- Toast -->
      <Frame BackgroundColor="{Binding ToastColor}" CornerRadius="8" Padding="12,8"
             IsVisible="{Binding ToastIsVisible}" HasShadow="False">
        <Label Text="{Binding ToastMessage}" TextColor="White" FontSize="13"
               HorizontalTextAlignment="Center" />
      </Frame>

      <!-- ===== STEP 1: Enter email ===== -->
      <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep1}">
        <Label Text="Step 1 of 2 — Enter your email" FontAttributes="Bold" FontSize="15"
               TextColor="{StaticResource PrimaryColor}" />

        <Entry Placeholder="Registered email address"
               Text="{Binding Email}"
               Keyboard="Email"
               AutomationId="ForgotEmailEntry" />

        <Button Text="Send Reset Code"
                Command="{Binding SendOtpCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                AutomationId="ForgotSendOtpButton" />
      </VerticalStackLayout>

      <!-- ===== STEP 2: Enter OTP ===== -->
      <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep2}">
        <Label Text="Step 2 of 2 — Enter reset code" FontAttributes="Bold" FontSize="15"
               TextColor="{StaticResource PrimaryColor}" />

        <Label FontSize="13" TextColor="Gray">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="A reset code was sent to " />
              <Span Text="{Binding Email}" FontAttributes="Bold" />
            </FormattedString>
          </Label.FormattedText>
        </Label>

        <Entry Placeholder="6-digit reset code"
               Text="{Binding OtpCode}"
               Keyboard="Numeric"
               MaxLength="6"
               AutomationId="ForgotOtpEntry" />

        <Button Text="Verify Code"
                Command="{Binding VerifyOtpCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                AutomationId="ForgotVerifyOtpButton" />

        <Button Text="{Binding OtpCooldownText}"
                Command="{Binding ResendOtpCommand}"
                IsEnabled="{Binding CanResendOtp}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource PrimaryColor}"
                AutomationId="ForgotResendOtpButton" />
      </VerticalStackLayout>

      <!-- Back to login -->
      <Button Text="← Back to Login"
              Command="{Binding GoBackCommand}"
              BackgroundColor="Transparent"
              TextColor="{StaticResource PrimaryColor}"
              FontSize="13"
              AutomationId="ForgotBackButton" />

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
