<?xml version="1.0" encoding="utf-8" ?>
<!--
    AppTopBar — unified top bar for all dashboard pages.
    Layout:  [ ☰ ]  [ Title / Subtitle ]  [ 🔔 ]  [ Avatar ]

    Bindable surface (set from the hosting page):
        Title              — page title text
        Subtitle           — optional greeting / sub-label
        ShowHamburger      — default true
        ShowNotificationBell — default true

    Avatar and user identity are driven internally from ITopBarService.
    The hosting page's BindingContext is NOT used for identity data.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:Ssomero.Views.Shared"
             x:Class="Ssomero.Views.Shared.AppTopBar"
             x:Name="topBar">

    <Grid x:Name="RootGrid"
          BackgroundColor="#5B21B6"
          ColumnDefinitions="Auto,*,Auto,Auto"
          ColumnSpacing="4">

        <!-- Safe-area top padding is applied in code-behind per platform -->

        <!-- ☰ Hamburger -->
        <Button x:Name="HamburgerButton"
                Grid.Column="0"
                Text="☰"
                FontSize="20"
                BackgroundColor="Transparent"
                TextColor="White"
                Padding="4,0,8,0"
                BorderWidth="0"
                VerticalOptions="Center"
                Clicked="OnHamburgerClicked" />

        <!-- Title + Subtitle -->
        <VerticalStackLayout Grid.Column="1"
                             Spacing="1"
                             VerticalOptions="Center">
            <Label x:Name="TitleLabel"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />
            <Label x:Name="SubtitleLabel"
                   FontSize="12"
                   TextColor="#C4B5FD"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"
                   IsVisible="False" />
        </VerticalStackLayout>

        <!-- 🔔 Notification bell -->
        <Button x:Name="BellButton"
                Grid.Column="2"
                Text="🔔"
                FontSize="18"
                BackgroundColor="Transparent"
                TextColor="White"
                Padding="4,0"
                BorderWidth="0"
                VerticalOptions="Center"
                Clicked="OnBellClicked" />

        <!-- Avatar (photo or initials) -->
        <shared:UserAvatarView x:Name="AvatarView"
                               Grid.Column="3"
                               Size="36"
                               Margin="0,0,4,0"
                               VerticalOptions="Center">
            <shared:UserAvatarView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAvatarTapped" />
            </shared:UserAvatarView.GestureRecognizers>
        </shared:UserAvatarView>

    </Grid>
</ContentView>
