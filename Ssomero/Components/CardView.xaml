<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ssomero.Components.CardView">
  <ContentView.ControlTemplate>
    <ControlTemplate>
      <Border StrokeShape="RoundRectangle 8"
              Padding="12"
              BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray950}}"
              Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
              StrokeThickness="1">
        <Border.Shadow>
          <Shadow Brush="{StaticResource Gray400Brush}" Offset="2,2" Radius="4" Opacity="0.3" />
        </Border.Shadow>
        <ContentPresenter />
      </Border>
    </ControlTemplate>
  </ContentView.ControlTemplate>
</ContentView>
