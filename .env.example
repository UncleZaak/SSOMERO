# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit the actual .env file — it is listed in .gitignore.

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-before-production

# Must be at least 32 characters
JWT_SECRET=replace-with-a-strong-random-secret-32chars

EMAIL_PASSWORD=your-smtp-password

# Used to protect the GET /metrics endpoint in Production
METRICS_API_KEY=replace-with-a-strong-random-key
