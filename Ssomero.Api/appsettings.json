{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ssomero-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173",
    "https://localhost:5173"
  ],
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=ssomero.db",
    "Redis": "",
    "Hangfire": ""
  },
  "AzureStorage": {
    "ConnectionString": "",
    "AvatarContainer": "avatars"
  },
  "Jwt": {
    "Secret": "SsomeroSuperSecretKeyThatIsAtLeast32Chars!",
    "Issuer": "Ssomero.Api",
    "Audience": "Ssomero.Client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "ssomerroapp@gmail.com",
    "SenderName": "Ssomero App",
    "Password": "",
    "EnableSsl": true,
    "TimeoutMs": 15000
  },
  "EnableSwagger": false,
  "Metrics": {
    "ApiKey": ""
  },
  "Payment": {
    "UseMock": true,
    "SecretKey": "",
    "WebhookSecret": "",
    "BaseUrl": "https://api.flutterwave.com/v3/"
  }
}

